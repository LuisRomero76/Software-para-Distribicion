# Backend Environment Variables
# Este archivo documenta todas las variables de entorno necesarias para el backend

# Server Configuration
# Puerto en el que escucha el servidor
PORT=3000

# Database Configuration
# Host del servidor MySQL
BD_HOST=localhost

# Puerto del servidor MySQL
BD_PORT=3306

# Usuario de la base de datos
BD_USERNAME=root

# Contraseña de la base de datos
BD_PASSWORD=

# Nombre de la base de datos
BD_DATABASE=soft_distribucion

# JWT Configuration
# Palabra clave secreta para firmar tokens JWT
JWT_SECRET_KEY=esta_es_la_palabra_clave

# Frontend URL (for CORS)
# URL del frontend para permitir CORS
FRONTEND_URL=http://localhost:5173

# Nota: Cambiar los valores por defecto en producción
# Especialmente PORT, BD_PASSWORD y JWT_SECRET_KEY
